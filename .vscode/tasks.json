{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bazel: refresh Rust IDE metadata",
      "type": "process",
      "command": "bazel",
      "args": ["run", "@rules_rust//tools/rust_analyzer:gen_rust_project", "--", "//rust/crates/..."],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Bazel: build",
      "type": "process",
      "command": "bazel",
      "args": ["build", "//..."],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Bazel: format Rust",
      "type": "process",
      "command": "bazel",
      "args": ["run", "@rules_rust//:rustfmt", "--", "//rust/crates/..."],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Bazel: test",
      "type": "process",
      "command": "bazel",
      "args": ["test", "//..."],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Bazel: Linux OCI images",
      "type": "process",
      "command": "bash",
      "args": ["tools/bazel-linux.sh", "images"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
