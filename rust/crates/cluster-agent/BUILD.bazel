load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
rust_binary(
    name = "cluster-agent", srcs = glob(["src/*.rs"]), crate_root = "src/main.rs",
    crate_name = "xscope_cluster_agent", edition = crate_edition(), aliases = aliases(),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = ["//rust/crates/domain", "//rust/crates/kubernetes", "//rust/crates/telemetry"] + all_crate_deps(normal = True),
    visibility = ["//visibility:public"],
)
rust_test(name = "cluster_agent_test", crate = ":cluster-agent", deps = all_crate_deps(normal_dev = True))
