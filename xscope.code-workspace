{
  "folders": [
    { "name": "XScope", "path": "." },
    { "name": "Rust", "path": "rust" },
    { "name": "Python", "path": "python" },
    { "name": "Web", "path": "web" }
  ],
  "settings": {
    "rust-analyzer.linkedProjects": ["rust-project.json"],
    "rust-analyzer.checkOnSave": false,
