{
  "uid": "xscope-overview",
  "title": "XScope Overview",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "tags": [
    "xscope"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 10,
      "title": "",
      "type": "text",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "### XSCOPE / 运行概览\n从流量与延迟发现异常，再进入 **[请求追踪](/d/xscope-traces/xscope-traces)** 定位具体调用链。"
      }
    },
    {
      "id": 11,
      "title": "当前请求速率",
      "description": "当前所选时间末端的请求速率。",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "xscope-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(xscope_http_requests_total{component=\"gateway\",route=\"/v1/chat/completions\"}[$__rate_interval]))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          },
          "noValue": "—",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "—",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "text": {
          "valueSize": 38,
          "titleSize": 13
        }
      }
    },
    {
      "id": 12,
      "title": "P95 请求延迟",
      "description": "无请求样本时显示 —；不代表延迟为零。",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "xscope-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(xscope_http_duration_seconds_bucket{component=\"gateway\",route=\"/v1/chat/completions\"}[$__rate_interval])))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "#B48EFA"
          },
          "noValue": "—",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "—",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "text": {
          "valueSize": 38,
          "titleSize": 13
        }
      }
    },
    {
      "id": 13,
      "title": "进行中的请求",
      "description": "正在处理的推理请求数。",
