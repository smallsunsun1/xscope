    {
      "id": 4,
      "title": "Token 吞吐",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "xscope-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (rate(xscope_inference_tokens_total{component=\"gateway\"}[$__rate_interval]))",
          "legendFormat": "{{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: token/s",
          "min": 0,
          "noValue": "—",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "axisGridShow": true,
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "input"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "输入"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "output"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "输出"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B48EFA"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "按输入 / 输出统计的 Token 速率，单位 token/s。"
    },
    {
      "id": 21,
      "title": "投递与采集",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 5,
      "title": "用量投递异常",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "xscope-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, outcome) (increase(xscope_background_events_total{operation=~\"usage_enqueue|usage_queue|usage_export|billing_pending_monitor\",outcome=~\"error|full|rejected|retry|permanent_failure|drain_timeout\"}[5m]))",
          "legendFormat": "{{operation}} · {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "—",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "axisGridShow": true,
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "最近 5 分钟的 HTTP 用量队列、投递和未决监控异常增量。计数器未出现时可能没有序列，不能仅由 No data 判断采集正常。"
    },
    {
      "id": 6,
      "title": "采集状态 · Pod 时间线",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "xscope-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"xscope|envoy|epp\"}",
          "legendFormat": "{{pod}} · {{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "无样本",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "离线",
                  "color": "#F2495C"
                },
                "1": {
                  "text": "在线",
                  "color": "#56C8AD"
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "axisWidth": 240
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F2495C",
                "value": null
              },
              {
                "color": "#56C8AD",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.65,
        "perPage": 7,
        "alignValue": "left",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "每行一个 Pod / 采集任务。绿色为 up=1，红色为 up=0，空白为无样本；历史 Pod 会保留在对应时间段。分页显示。"
    }
  ],
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "请求追踪",
      "type": "link",
      "url": "/d/xscope-traces/xscope-traces",
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "description": "XScope 运行概览：关键数值、推理流量、延迟、Token 吞吐与采集 / 用量投递状态。"
}
