        "label": "操作名",
        "description": "留空查询全部操作；也可填写准确 span 名，如 http.request。",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "text": "",
            "value": "",
            "selected": true
          }
