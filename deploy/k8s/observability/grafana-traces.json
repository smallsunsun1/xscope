{
  "uid": "xscope-traces",
  "title": "XScope 请求追踪",
  "description": "搜索已采集的调用链，点击 Trace ID 打开详情。列表是最多 100 条采样结果，不代替 Prometheus 请求计数。",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "tags": [
    "xscope",
    "tracing"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "服务",
        "type": "custom",
        "query": "xscope-gateway,xscope-envoy,xscope-epp,xscope-runtime,xscope-control-plane,xscope-cluster-agent,xscope-operator",
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "xscope-gateway",
          "value": "xscope-gateway"
        },
        "options": [
          {
            "text": "xscope-gateway",
