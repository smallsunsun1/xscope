package(default_visibility = ["//visibility:public"])

exports_files([
    "deploy/k8s/overlays/local/kustomization.yaml",
    "deploy/k8s/overlays/local/grafana-service.yaml",
    "deploy/k8s/overlays/local/grafana-ingress.yaml",
])

filegroup(
    name = "api-contracts",
    srcs = glob([
        "api/**/*.json",
        "api/**/*.yaml",
    ]),
)

filegroup(
    name = "k8s-manifests",
    srcs = glob(["deploy/k8s/**/*.yaml"]),
)

alias(
    name = "control-plane",
    actual = "//rust/crates/control-plane",
)

alias(
    name = "cluster-agent",
    actual = "//rust/crates/cluster-agent",
)

alias(
    name = "operator",
    actual = "//rust/crates/operator",
)

alias(
    name = "gateway",
    actual = "//rust/crates/gateway",
)

alias(
    name = "runtime",
    actual = "//python:runtime",
)

alias(
    name = "console",
    actual = "//web/console",
)
