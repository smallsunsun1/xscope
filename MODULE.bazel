module(
    name = "xscope",
    version = "0.1.0",
)

bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_python", version = "2.3.2")
bazel_dep(name = "aspect_rules_js", version = "3.4.1")
bazel_dep(name = "rules_nodejs", version = "6.7.5")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "platforms", version = "1.1.0")

# Upstream schemas, not hand-written substitutes. Deployment consumes Bazel's
# checksum-verified bundle before creating InferencePool resources.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Public, checksum-pinned security tooling; no credentials enter Bazel actions.
http_archive(
    name = "gitleaks_darwin_arm64",
    build_file_content = 'exports_files(["gitleaks"])',
    sha256 = "b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5",
    urls = ["https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_darwin_arm64.tar.gz"],
)

http_archive(
    name = "gitleaks_darwin_x64",
    build_file_content = 'exports_files(["gitleaks"])',
    sha256 = "dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709",
    urls = ["https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_darwin_x64.tar.gz"],
)

http_archive(
    name = "gitleaks_linux_arm64",
    build_file_content = 'exports_files(["gitleaks"])',
    sha256 = "e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080",
    urls = ["https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_arm64.tar.gz"],
)

http_archive(
    name = "gitleaks_linux_x64",
    build_file_content = 'exports_files(["gitleaks"])',
    sha256 = "551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb",
    urls = ["https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz"],
)

http_file(
    name = "inference_pool_crd",
    downloaded_file_path = "inferencepools.yaml",
    sha256 = "0bc3ddd94db6f588a5cecc627c39e3d12b4343d51c48d47ffa68c50fa73c290c",
    urls = ["https://raw.githubusercontent.com/kubernetes-sigs/gateway-api-inference-extension/v1.5.0/config/crd/bases/inference.networking.k8s.io_inferencepools.yaml"],
)

http_file(
    name = "inference_objective_crd",
    downloaded_file_path = "inferenceobjectives.yaml",
    sha256 = "c1e763412fcbe2b55e9282850156269a10053be2d052547cb80a2ca639c09990",
    urls = ["https://raw.githubusercontent.com/llm-d/llm-d-router/v0.9.0/config/crd/bases/llm-d.ai_inferenceobjectives.yaml"],
)

http_file(
    name = "inference_model_rewrite_crd",
    downloaded_file_path = "inferencemodelrewrites.yaml",
    sha256 = "62a07fff40e10e919c245d895457a9c15be22947b45f06815552ae8fffaab405",
    urls = ["https://raw.githubusercontent.com/llm-d/llm-d-router/v0.9.0/config/crd/bases/llm-d.ai_inferencemodelrewrites.yaml"],
)

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "runtime_base",
    digest = "sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285",
    image = "mirror.gcr.io/library/python",
    platforms = [
        "linux/arm64/v8",
        "linux/amd64",
    ],
)
use_repo(oci, "runtime_base", "runtime_base_linux_amd64", "runtime_base_linux_arm64_v8")

http_file(
    name = "metrics_server_manifest",
    downloaded_file_path = "components.yaml",
    sha256 = "4a672c4891902573a3ff753cece5de1bf1f55dd053403dfec39df9d1636b7ff1",
    urls = ["https://github.com/kubernetes-sigs/metrics-server/releases/download/v0.8.1/components.yaml"],
)

http_file(
    name = "keda_manifest",
    downloaded_file_path = "keda.yaml",
    sha256 = "11c2c88a126c33d21a81315c9462ba410e27a87598b5ddae7a1fdd6eff376ef7",
    urls = ["https://github.com/kedacore/keda/releases/download/v2.20.1/keda-2.20.1.yaml"],
)

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.13.0")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm", dev_dependency = True)
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//web:pnpm-lock.yaml",
)
use_repo(npm, "npm")

python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
python_config.explicit_init_py(default = True)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.98.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

foreign_cc_tools = use_extension("@rules_foreign_cc//foreign_cc:extensions.bzl", "tools")
use_repo(foreign_cc_tools, "cmake_3.31.8_toolchains")

register_toolchains("@cmake_3.31.8_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.annotation(
    build_script_env = {"CMAKE": "$${pwd}/$(CMAKE)"},
    build_script_toolchains = ["@rules_foreign_cc//toolchains:current_cmake_toolchain"],
    crate = "aws-lc-sys",
)
crate.annotation(
    build_script_env = {"CMAKE": "$${pwd}/$(CMAKE)"},
    build_script_toolchains = ["@rules_foreign_cc//toolchains:current_cmake_toolchain"],
    crate = "libz-ng-sys",
)

# SQLx 0.9 gates Executor::describe behind `offline` in both core and
# database drivers. Cargo unifies those features automatically; crate_universe
# needs the driver-side feature stated explicitly.
crate.annotation(
    crate = "sqlx-postgres",
    crate_features = ["offline"],
)
crate.annotation(
    crate = "k8s-openapi",
    # Keep generated rust-project.json in sync with the feature selected by
    # k8s-openapi's build script so rust-analyzer can expand CustomResource.
    rustc_flags = ['--cfg=k8s_openapi_enabled_version="1.34"'],
)
crate.annotation(
    crate = "smallvec",
    crate_features = ["serde"],
    deps = ["@crates__serde-1.0.229//:serde"],
)

# Match the gateway's bounded request admission buffer on H1 and H2. Pingora
# replays this buffer after request_filter; inference POST retries stay disabled.
crate.annotation(
    crate = "pingora-core",
    patch_args = ["-p1"],
    patches = ["//third_party:pingora-request-buffer.patch"],
)
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//rust:Cargo.lock",
    isolated = False,
    manifests = ["//rust:Cargo.toml"],
)
use_repo(crate, "crates")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "xscope_pypi",
    python_version = "3.13",
    requirements_lock = "//python:requirements.lock",
)
use_repo(pip, "xscope_pypi")

pip.parse(
    hub_name = "xscope_telemetry_pypi",
    python_version = "3.13",
    requirements_lock = "//python:telemetry.lock",
)
use_repo(pip, "xscope_telemetry_pypi")
