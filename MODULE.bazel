module(
    name = "xscope",
    version = "0.1.0",
)

bazel_dep(name = "rules_go", version = "0.63.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.52.2")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_python", version = "2.3.2")
bazel_dep(name = "aspect_rules_js", version = "3.4.1")
bazel_dep(name = "rules_nodejs", version = "6.7.5")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "platforms", version = "1.1.0")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "runtime_base",
    image = "mirror.gcr.io/library/python",
    digest = "sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285",
    platforms = ["linux/arm64", "linux/amd64"],
)
use_repo(oci, "runtime_base", "runtime_base_linux_amd64", "runtime_base_linux_arm64")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.13.0")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm", dev_dependency = True)
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//web:pnpm-lock.yaml",
)
use_repo(npm, "npm")

python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
python_config.explicit_init_py(default = True)

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    urls = [
        "https://mirrors.aliyun.com/golang/{}",
        "https://dl.google.com/go/{}",
    ],
    version = "1.26.5",
)

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//go:go.mod")
use_repo(
    go_deps,
    "com_github_go_chi_chi_v5",
    "io_k8s_api",
    "io_k8s_apimachinery",
    "io_k8s_client_go",
    "io_k8s_sigs_controller_runtime",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.94.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

foreign_cc_tools = use_extension("@rules_foreign_cc//foreign_cc:extensions.bzl", "tools")
use_repo(foreign_cc_tools, "cmake_3.31.8_toolchains")

register_toolchains("@cmake_3.31.8_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.annotation(
    build_script_env = {"CMAKE": "$${pwd}/$(CMAKE)"},
    build_script_toolchains = ["@rules_foreign_cc//toolchains:current_cmake_toolchain"],
    crate = "aws-lc-sys",
)
crate.annotation(
    build_script_env = {"CMAKE": "$${pwd}/$(CMAKE)"},
    build_script_toolchains = ["@rules_foreign_cc//toolchains:current_cmake_toolchain"],
    crate = "libz-ng-sys",
)
# SQLx 0.9 gates Executor::describe behind `offline` in both core and
# database drivers. Cargo unifies those features automatically; crate_universe
# needs the driver-side feature stated explicitly.
crate.annotation(
    crate = "sqlx-postgres",
    crate_features = ["offline"],
)
crate.annotation(
    crate = "smallvec",
    crate_features = ["serde"],
    deps = ["@crates__serde-1.0.229//:serde"],
)
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//rust:Cargo.lock",
    isolated = False,
    manifests = ["//rust:Cargo.toml"],
)
use_repo(crate, "crates")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "xscope_pypi",
    python_version = "3.13",
    requirements_lock = "//python:requirements.lock",
)
use_repo(pip, "xscope_pypi")
